
@model FeedbackManagement.Models.Feedback

@using (Html.BeginForm("Index", "Module", FormMethod.Post,
    new { @class = "feedback-form" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.Name, "Full Name")
        @Html.TextBoxFor(m => m.Name, new
        {
            @class = "form-control",
            placeholder = "Enter your full name",
            autocomplete = "name"
        })
        @Html.ValidationMessageFor(m => m.Name, "",
            new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email, "Email Address")
        @Html.TextBoxFor(m => m.Email, new
        {
            @class = "form-control",
            placeholder = "Enter your email address",
            type = "email",
            autocomplete = "email"
        })
        @Html.ValidationMessageFor(m => m.Email, "",
            new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Rating, "Rate Your Experience")
        @Html.DropDownListFor(m => m.Rating,
            new SelectList(new[]
            {
                new { Value = "1", Text = "★ 1 - Poor" },
                new { Value = "2", Text = "★★ 2 - Fair" },
                new { Value = "3", Text = "★★★ 3 - Good" },
                new { Value = "4", Text = "★★★★ 4 - Very Good" },
                new { Value = "5", Text = "★★★★★ 5 - Excellent" }
            }, "Value", "Text"),
            "-- Select your rating --",
            new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Rating, "",
            new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Comments, "Your Feedback")
        @Html.TextAreaFor(m => m.Comments, new
        {
            @class = "form-control",
            rows = "5",
            maxlength = "500",
            placeholder = "Tell us what you liked or how we can improve..."
        })
        <small style="color: #718096;">
            Maximum 500 characters
        </small>
        @Html.ValidationMessageFor(m => m.Comments, "",
            new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-submit">
        ✉ Submit Feedback
    </button>

    <button type="reset" class="btn btn-default">
        Reset Form
    </button>
}